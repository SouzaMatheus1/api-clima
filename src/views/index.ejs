<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clima check</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <div class="container">
        <i class="fa-solid fa-cloud"></i><h1 class="text-center my-4">Bem-vindo!</h1>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 offset-md-3">
            <form action="/clima" method="GET">
                <label class="form-label" for="cidade_input">Selecione o nome da cidade:</label>
                <select name="cidade" id="cidade_select" class="form-control" placeholder="Selecione uma cidade">
                    <option value="">Selecione...</option>
                    <% if (dataCities) { %>
                        <% dataCities.cidades.forEach(function(cidade) { %>
                            <option value="<%= cidade %>"><%= cidade %></option>
                        <% }); %>
                    <% }; %>
                </select>
                <button id="consultar_clima" class="btn btn-primary mt-3">Consultar clima</button>
            </form>
        </div>
    </div>
    
    <!-- <form action="/csv" method="GET">
        <button id="consultar_csv" class="btn btn-primary mt-3">Consultar csv</button>
    </form> -->

</body>

</html>