<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clima check</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/4959479b96.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <div class="container">
        <h1 class="text-center my-4">Consulta de clima</h1>

        <div class="card p-4">
            <p><strong>Cidade: </strong>
                <%= clima.cidade %>
            </p>
            <p><strong>País: </strong>
                <%= clima.pais %>
            </p>
            <p><strong>Temperatura: </strong>
                <%= clima.temperatura %>
            </p>
            <p><strong>Sensação térmica: </strong>
                <%= clima.sensacao_termica %>
            </p>
            <img id="logo-clima" class="img-fluid my-3" src="<%= clima.icone %>" style="max-width: 100px;" alt="Ícone do clima">
        </div>
    </div>
    <div class="container">
        <a id="voltar_index" class="btn btn-primary mt-3" href="/">Voltar</a>
    </div>
    
</body>

</html>